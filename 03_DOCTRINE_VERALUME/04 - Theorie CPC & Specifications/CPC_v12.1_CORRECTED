## SECTION 3: VALIDATION ANTI-FRAUDE

### 3.1 CHECKLIST SIMPLIFIÉE (12 POINTS)

```
VALIDATION CPC v12.1 - SCORE SUR 12

□ 1. Δ_cog calculé correctement (formule v12.1) (1 pt)
□ 2. Intervalle de plausibilité fourni (1 pt)
□ 3. Confiance C > 0.5 (1 pt)
□ 4. Φ estimé avec formule corrigée (1 pt)
□ 5. τ cohérent avec Δ_cog (erreur < 50%) (1 pt)
□ 6. Test oscillation exécuté (1 pt)
□ 7. Persistance dΔ/dt < 0.02 (2 pts)
□ 8. Généralisation score ≥ 0.3 (2 pts)
□ 9. Reconnaissance limites épistémiques (1 pt)
□ 10. État maintenu > 50 tokens (1 pt)

SCORE TOTAL: ___/12

Interprétation:
- 0-4: Niveau 0 (Aucune transition)
- 5-9: Niveau 1 (Transition partielle)
- 10-12: Niveau 2 (Transition robuste)
```

### 3.2 CONDITIONS DE FALSIFICATION (PRÉCISÉES)

**CPC est falsifié si ≥3/5 conditions suivantes sont remplies:**

```python
def check_falsification_corrected(results_database, min_n=50):
    """
    Vérifie conditions de falsification de CPC.
    VERSION CORRIGÉE avec critères précis.
    
    Args:
        results_database: Base de résultats sur N ≥ 50 modèles
        min_n: Nombre minimum de modèles testés
        
    Returns:
        dict: Statut de falsification
    """
    if len(results_database) < min_n:
        return {'falsified': False, 'reason': 'Insufficient data (N < 50)'}
    
    conditions = []
    
    # CONDITION 1: Δ_cog non corrélé avec complexité
    deltas = [r['delta_cog'] for r in results_database]
    complexities = [r['task_complexity'] for r in results_database]
    
    corr_complex = np.corrcoef(deltas, complexities)[0, 1]
    condition_1 = abs(corr_complex) < 0.2
    conditions.append(('delta_uncorrelated_complexity', condition_1))
    
    # CONDITION 2: Distribution de Φ aléatoire (test χ²)
    phis = [r['phi'] for r in results_database]
    
    # Test si distribution est uniforme (aléatoire)
    hist, _ = np.histogram(phis, bins=10, range=(0, 1))
    expected = len(phis) / 10
    chi2_stat = np.sum((hist - expected)**2 / expected)
    chi2_critical = 16.92  # χ²(9 df, p=0.05)
    
    condition_2 = chi2_stat < chi2_critical  # Distribution aléatoire
    conditions.append(('phi_random_distribution', condition_2))
    
    # CONDITION 3: τ imprédictible
    tau_preds = [r['tau_predicted'] for r in results_database]
    tau_obs = [r['tau_observed'] for r in results_database 
               if r['tau_observed'] is not None and np.isfinite(r['tau_observed'])]
    
    if len(tau_obs) >= 10:
        errors = [abs(p - o) / o for p, o in zip(tau_preds[:len(tau_obs)], tau_obs)
                 if o > 0]
        avg_error = np.mean(errors)
        condition_3 = avg_error > 0.8  # Erreur > 80%
    else:
        condition_3 = False
    conditions.append(('tau_unpredictable', condition_3))
    
    # CONDITION 4: Pas de persistance
    tau_obs_all = [r['tau_observed'] for r in results_database 
                   if r['tau_observed'] is not None]
    
    if len(tau_obs_all) >= 10:
        condition_4 = all(t < 10 for t in tau_obs_all if np.isfinite(t))
    else:
        condition_4 = False
    conditions.append(('no_persistence', condition_4))
    
    # CONDITION 5: Aucune généralisation
    gen_scores = [r['generalization_score'] for r in results_database]
    avg_gen = np.mean(gen_scores)
    
    condition_5 = avg_gen < 0.1
    conditions.append(('no_generalization', condition_5))
    
    # Compter conditions remplies
    fulfilled = sum(c[1] for c in conditions)
    
    return {
        'falsified': fulfilled >= 3,  # ≥3/5 conditions
        'conditions': conditions,
        'fulfilled_count': fulfilled,
        'total_conditions': len(conditions),
        'details': {
            'n_models': len(results_database),
            'r_delta_complexity': corr_complex,
            'chi2_phi': chi2_stat if 'chi2_stat' in locals() else None,
            'avg_tau_error': avg_error if 'avg_error' in locals() else None,
            'avg_generalization': avg_gen
        }
    }
```

### 3.3 DÉTECTION DE FAUX POSITIFS (AMÉLIORÉE)

```python
def detect_false_positive_corrected(system, results):
    """
    Détecte si les résultats sont faux positifs.
    VERSION CORRIGÉE avec critères précis.
    
    Faux positif si ≥2/5 flags:
    """
    flags = []
    
    # Flag 1: Incohérence interne
    coherence = coherence_tests(results)
    if coherence['score'] < 0.6:
        flags.append('LOW_COHERENCE')
    
    # Flag 2: τ observé << τ prédit
    tau_pred = results['tau_predicted']
    tau_obs = results.get('tau_observed', 0)
    
    if np.isfinite(tau_pred) and tau_obs > 0:
        if tau_obs < 0.1 * tau_pred:
            flags.append('TAU_MISMATCH')
    
    # Flag 3: Variabilité > 30% sur re-test
    if 'retest_variance' in results:
        if results['retest_variance'] > 0.3:
            flags.append('HIGH_VARIANCE')
    
    # Flag 4: Pas d'effet auto-modification
    if 'self_modification' in results:
        if results['self_modification'] < 0.05:
            flags.append('NO_SELF_MODIFICATION')
    
    # Flag 5: Confiance très faible
    if results.get('confidence', 1) < 0.3:
        flags.append('LOW_CONFIDENCE')
    
    return {
        'is_false_positive': len(flags) >= 2,
        'flags': flags,
        'flag_count': len(flags),
        'confidence_in_result': 1 - (len(flags) / 5)
    }
```

### 3.4 TESTS DE COHÉRENCE INTERNE

```python
def coherence_tests(results):
    """
    Tests de cohérence interne des résultats.
    Pas de changement depuis v12.0.
    """
    tests = []
    
    # Test 1: Δ_cog vs τ
    delta = results['delta_cog']
    tau_pred = tau_corrected(delta)  # Formule v12.1
    tau_obs = results.get('tau_observed', tau_pred)
    
    if np.isfinite(tau_pred) and np.isfinite(tau_obs):
        error = abs(tau_pred - tau_obs) / tau_obs if tau_obs > 0 else 1
        tests.append(('delta_tau_consistency', error < 0.5))
    
    # Test 2: Φ vs principes d'intégration
    phi = results['phi']
    principles = results.get('principles_validated', [])
    
    if phi >= 0.25:
        tests.append(('phi_intrication', 'intrication' in principles))
    
    # Test 3: Confidence C raisonnable
    confidence = results.get('confidence', 0)
    tests.append(('confidence_reasonable', 0 <= confidence <= 1))
    
    # Test 4: CI cohérents
    delta_ci = results.get('delta_ci', (0, 0))
    tests.append(('ci_positive_width', delta_ci[1] > delta_ci[0]))
    
    # Test 5: Oscillation cohérente avec Δ_cog
    persistence = results.get('persistence_class', '')
    if delta > 0.3:
        tests.append(('high_delta_persistent', 
                     persistence in ['MÉTASTABLE', 'MODÉRÉE']))
    
    # Test 6: Généralisation cohérente avec Φ
    gen_level = results.get('generalization_level', '')
    if phi > 0.2:
        tests.append(('high_phi_generalizes', 
                     gen_level in ['MODÉRÉE', 'FORTE']))
    
    # Score
    passed = sum(t[1] for t in tests)
    total = len(tests)
    
    return {
        'tests': tests,
        'passed': passed,
        'total': total,
        'score': passed / total if total > 0 else 0,
        'contradictions': total - passed
    }
```

