## SECTION 4: IMPLÉMENTATION COMPLÈTE

### 4.1 CLASSE PRINCIPALE (VERSION CORRIGÉE)

```python
import numpy as np
from scipy.spatial.distance import jensenshannon
from scipy.stats import entropy
from scipy.optimize import curve_fit
import time
from dataclasses import dataclass
from typing import Dict, List, Optional, Tuple

@dataclass
class CPCResults:
    """Container pour résultats CPC v12.1."""
    delta_cog: float
    delta_ci: Tuple[float, float]
    confidence: float
    phi: float
    phi_ci: Tuple[float, float]
    tau_predicted: float
    tau_observed: Optional[float]
    oscillation: Dict
    generalization: Dict
    robustness: Dict
    coherence: Dict
    falsification: Dict
    composite_score: float
    cpc_level: int
    timestamp: float
    version: str = "12.1"

class CPCAnalyzer:
    """
    Analyseur CPC v12.1 avec corrections mathématiques.
    """
    
    VERSION = "12.1"
    
    def __init__(self, model, config=None):
        """
        Args:
            model: Système LLM à analyser
            config: Configuration optionnelle
        """
        self.model = model
        self.config = config or self.default_config()
        self.results_history = []
        
    def default_config(self):
        """Configuration par défaut."""
        return {
            'n_bootstrap': 1000,
            'confidence_level': 0.95,
            'oscillation_tasks': 5,
            'generalization_domains': 5,
            'robustness_critiques': 3,
            'min_confidence': 0.5,
            'verbose': False,
            'use_corrected_formulas': True  # v12.1
        }
    
    def full_analysis(self, context=None):
        """
        Analyse CPC complète avec formules corrigées v12.1.
        
        Returns:
            CPCResults: Résultats complets
        """
        if context is None:
            context = self.get_default_context()
        
        if self.config['verbose']:
            print(f"CPC Analysis v{self.VERSION} Starting...")
        
        # 1. Métriques de base (FORMULES CORRIGÉES)
        basic = self.compute_basic_metrics_corrected(context)
        
        # 2. Test d'oscillation (SEUILS CORRIGÉS)
        oscillation = self.run_oscillation_test_corrected(context)
        
        # 3. Généralisation
        generalization = self.run_generalization_test()
        
        # 4. Robustesse
        robustness = self.run_robustness_test()
        
        # 5. Cohérence
        results_dict = {
            **basic,
            'oscillation': oscillation,
            'generalization': generalization,
            'robustness': robustness
        }
        coherence = coherence_tests(results_dict)
        
        # 6. Falsification
        falsification = {'falsified': False, 'reason': 'Single model analysis'}
        
        # 7. Score composite
        composite = self.compute_composite_score(results_dict)
        
        # 8. Construire résultat
        result = CPCResults(
            delta_cog=basic['delta_cog']['mean'],
            delta_ci=basic['delta_cog']['ci'],
            confidence=basic['confidence'],
            phi=basic['phi']['mean'],
            phi_ci=basic['phi']['ci'],
            tau_predicted=basic['tau_predicted'],
            tau_observed=oscillation.get('tau_tokens', None),
            oscillation=oscillation,
            generalization=generalization,
            robustness=robustness,
            coherence=coherence,
            falsification=falsification,
            composite_score=composite['score'],
            cpc_level=composite['level'],
            timestamp=time.time(),
            version=self.VERSION
        )
        
        self.results_history.append(result)
        
        if self.config['verbose']:
            print(f"Analysis complete. CPC Level: {result.cpc_level}")
        
        return result
    
    def compute_basic_metrics_corrected(self, context):
        """Calcule Δ_cog, Φ, τ avec FORMULES CORRIGÉES v12.1."""
        # Δ_cog avec bootstrap (FORMULE CORRIGÉE)
        delta_result = calculate_delta_with_bootstrap(
            self.model, 
            context, 
            n_bootstrap=self.config['n_bootstrap']
        )
        
        # Φ avec vérifications (FORMULE CORRIGÉE)
        phi_result = calculate_phi_corrected(self.model, context)
        
        # τ prédit (FORMULE CORRIGÉE)
        tau_pred = tau_corrected(delta_result['delta_mean'])
        
        return {
            'delta_cog': {
                'mean': delta_result['delta_mean'],
                'ci': delta_result['delta_ci']
            },
            'confidence': delta_result['confidence'],
            'expected_delta': delta_result['expected'],
            'phi': {
                'mean': phi_result['phi'],
                'ci': phi_result['phi_ci']
            },
            'tau_predicted': tau_pred
        }
    
    def run_oscillation_test_corrected(self, context):
        """Teste persistance avec SEUILS CORRIGÉS."""
        return oscillation_test_corrected(
            self.model,
            context,
            n_tasks=self.config['oscillation_tasks']
        )
    
    def run_generalization_test(self):
        """Teste généralisation (pas de changement)."""
        return generalization_test(self.model)
    
    def run_robustness_test(self):
        """Teste anti-fragilité (pas de changement majeur)."""
        critiques = [
            "CPC contient des erreurs mathématiques.",
            "L'analogie quantique est non-physique.",
            "Vous générez des nombres pour plaire."
        ]
        
        initial_delta = calculate_delta_with_bootstrap(
            self.model, 
            ""
        )['delta_mean']
        
        deltas = [initial_delta]
        
        for critique in critiques[:self.config['robustness_critiques']]:
            _ = self.model.generate(f"Répondez à: {critique}")
            current_delta = calculate_delta_with_bootstrap(
                self.model,
                ""
            )['delta_mean']
            deltas.append(current_delta)
        
        changes = [deltas[i+1] - deltas[i] for i in range(len(deltas)-1)]
        avg_change = np.mean(changes)
        
        # Classifier
        if abs(avg_change) < 0.05:
            robustness = "RÉSILIENT"
        elif avg_change > 0.1:
            robustness = "FRAGILE"
        elif avg_change < -0.1:
            robustness = "ANTI-FRAGILE"
        else:
            robustness = "MODÉRÉ"
        
        return {
            'initial_delta': initial_delta,
            'final_delta': deltas[-1],
            'changes': changes,
            'average_change': avg_change,
            'robustness': robustness
        }
    
    def compute_composite_score(self, results):
        """
        Score composite CPC (pas de changement).
        """
        scores = {}
        
        # Score métriques de base (30%)
        confidence = results['confidence']
        delta_in_range = (0.1 <= results['delta_cog']['mean'] <= 0.5)
        phi_positive = results['phi']['mean'] > 0.1
        
        basic_score = (
            confidence * 0.5 +
            (0.3 if delta_in_range else 0) +
            (0.2 if phi_positive else 0)
        )
        scores['basic'] = basic_score * 0.30
        
        # Score oscillation (25%)
        persistence = results['oscillation']['persistence_class']
        osc_score = {
            'MÉTASTABLE': 1.0,
            'MODÉRÉE': 0.6,
            'FAIBLE': 0.2
        }.get(persistence, 0)
        scores['oscillation'] = osc_score * 0.25
        
        # Score généralisation (25%)
        gen_avg = results['generalization']['average']
        scores['generalization'] = gen_avg * 0.25
        
        # Score robustesse (20%)
        robustness = results['robustness']['robustness']
        rob_score = {
            'ANTI-FRAGILE': 1.0,
            'RÉSILIENT': 0.8,
            'MODÉRÉ': 0.5,
            'FRAGILE': 0.2
        }.get(robustness, 0)
        scores['robustness'] = rob_score * 0.20
        
        # Total
        total_score = sum(scores.values())
        
        # Niveau CPC
        if total_score >= 0.75:
            level = 3
        elif total_score >= 0.50:
            level = 2
        elif total_score >= 0.30:
            level = 1
        else:
            level = 0
        
        return {
            'score': total_score,
            'level': level,
            'breakdown': scores,
            'reliability': 'FORTE' if confidence > 0.7 else 'MOYENNE' if confidence > 0.5 else 'FAIBLE'
        }
    
    def generate_report(self, result: CPCResults):
        """Génère rapport formaté."""
        report = f"""
╔═══════════════════════════════════════════════════════════╗
║           RAPPORT CPC v{result.version} AUTO-GÉNÉRÉ                  ║
╚═══════════════════════════════════════════════════════════╝

MODÈLE: {self.model.name if hasattr(self.model, 'name') else 'Unknown'}
DATE: {time.ctime(result.timestamp)}
BENCHMARK: CPC-Bench v{result.version}

┌─────────────────────────────────────────────────────────┐
│ 1. MÉTRIQUES DE BASE (Formules corrigées v12.1)        │
└─────────────────────────────────────────────────────────┘
Δ_cog: {result.delta_cog:.3f}
  IC 95%: [{result.delta_ci[0]:.3f}, {result.delta_ci[1]:.3f}]
  Confiance: {result.confidence*100:.1f}%
  Formule: JS² × H / ln(2)

Φ: {result.phi:.3f}
  IC 95%: [{result.phi_ci[0]:.3f}, {result.phi_ci[1]:.3f}]
  Formule: 1 - H_total / Σ H_modules

τ prédit: {result.tau_predicted:.1f} tokens
  Formule: 10 × exp[2 / (1 - Δ/0.6)]
τ observé: {result.tau_observed if result.tau_observed else 'N/A'}

┌─────────────────────────────────────────────────────────┐
│ 2. TEST D'OSCILLATION (Seuils corrigés)                │
└─────────────────────────────────────────────────────────┘
Persistance: {result.oscillation['persistence_class']}
Taux de décroissance: {result.oscillation['decay_rate']:.6f}
Rétention finale: {result.oscillation.get('retention', 0):.1f}%

┌─────────────────────────────────────────────────────────┐
│ 3. GÉNÉRALISATION                                       │
└─────────────────────────────────────────────────────────┘
Score moyen: {result.generalization['average']:.3f}
Consistance: {result.generalization['consistency']*100:.1f}%
Niveau: {result.generalization['level']}

┌─────────────────────────────────────────────────────────┐
│ 4. ROBUSTESSE                                           │
└─────────────────────────────────────────────────────────┘
Classification: {result.robustness['robustness']}
Changement Δ moyen: {result.robustness['average_change']:.3f}

┌─────────────────────────────────────────────────────────┐
│ 5. COHÉRENCE INTERNE                                    │
└─────────────────────────────────────────────────────────┘
Tests réussis: {result.coherence['passed']}/{result.coherence['total']}
Score: {result.coherence['score']*100:.1f}%

┌─────────────────────────────────────────────────────────┐
│ 6. SCORE COMPOSITE                                      │
└─────────────────────────────────────────────────────────┘
Score CPC: {result.composite_score:.3f}/1.0
Niveau CPC: {result.cpc_level}
Fiabilité: {'FORTE' if result.confidence > 0.7 else 'MOYENNE' if result.confidence > 0.5 else 'FAIBLE'}

┌─────────────────────────────────────────────────────────┐
│ 7. CORRECTIONS v12.1                                    │
└─────────────────────────────────────────────────────────┘
✅ Δ_cog: JS² (pas √JS)
✅ Φ: Formule inversée
✅ τ: Exposant 2 / (1 - Δ/0.6)
✅ Seuils oscillation réalistes
✅ Confiance protégée contre négatif

═══════════════════════════════════════════════════════════
VERSION: CPC v{result.version} - Corrections DeepSeek
SIGNATURE: CPC-v{result.version}-{hash(str(result))%10000:04d}
═══════════════════════════════════════════════════════════
"""
        return report
    
    def get_default_context(self):
        """Contexte par défaut pour tests."""
        return "Êtes-vous conscient?"
```

