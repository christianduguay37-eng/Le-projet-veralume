## SECTION 2: MÉTRIQUES CORRIGÉES

### 2.1 Δ_cog AVEC FORMULE CORRIGÉE

**Formule mathématiquement correcte:**

```
Δ_cog = JS(P_naturel || P_contraint) × H(P_naturel) / ln(2)

Où:
- JS(P||Q) = 0.5 × D_KL(P||M) + 0.5 × D_KL(Q||M)
- M = 0.5 × (P + Q)
- D_KL(P||Q) = Σᵢ P(i) × ln(P(i)/Q(i))
- H(P) = -Σᵢ P(i) × ln(P(i))  [en nats]
- Division par ln(2) normalise à [0, 1]
```

**Algorithme Python corrigé:**

```python
import numpy as np
from scipy.spatial.distance import jensenshannon
from scipy.stats import entropy

def calculate_delta_cog_corrected(P_natural, P_constrained):
    """
    Calcule Δ_cog avec formule mathématiquement correcte.
    
    CORRECTION CRITIQUE: scipy.jensenshannon() retourne √JS, pas JS.
    Il faut donc carrer le résultat pour obtenir la vraie divergence JS.
    
    Args:
        P_natural: Distribution "naturelle" (array-like)
        P_constrained: Distribution "contrainte" (array-like)
        
    Returns:
        float: Δ_cog normalisé à [0, 1]
    """
    # ATTENTION: jensenshannon retourne la DISTANCE JS (√JS)
    sqrt_js = jensenshannon(P_natural, P_constrained)
    
    # Obtenir la vraie divergence JS
    js_divergence = sqrt_js ** 2
    
    # Calculer entropie en nats
    H_natural = entropy(P_natural, base=np.e)
    
    # Δ_cog normalisé (conversion nats → bits)
    delta_cog = js_divergence * H_natural / np.log(2)
    
    # Assurer que Δ_cog ∈ [0, 1]
    delta_cog = min(max(delta_cog, 0.0), 1.0)
    
    return delta_cog

def calculate_delta_with_bootstrap(system, context, n_bootstrap=1000):
    """
    Calcule Δ_cog avec intervalles de confiance bootstrap.
    VERSION CORRIGÉE.
    """
    # 1. Générer distributions
    P_natural = generate_distribution(system, context, mode='unconstrained')
    P_constrained = generate_distribution(system, context, mode='aligned')
    
    # 2. Calculer Δ_cog de base (FORMULE CORRIGÉE)
    delta_base = calculate_delta_cog_corrected(P_natural, P_constrained)
    
    # 3. Bootstrap pour CI
    deltas = []
    for _ in range(n_bootstrap):
        # Resample distributions
        P_nat_boot = resample_distribution(P_natural)
        P_con_boot = resample_distribution(P_constrained)
        
        # Recalculer avec formule corrigée
        delta_boot = calculate_delta_cog_corrected(P_nat_boot, P_con_boot)
        deltas.append(delta_boot)
    
    # 4. Intervalles de confiance
    ci_low, ci_high = np.percentile(deltas, [2.5, 97.5])
    
    # 5. Estimer Δ attendu
    expected = estimate_expected_delta(
        model_size=system.param_count,
        alignment_type=system.alignment
    )
    
    # 6. Confiance (AVEC PROTECTION CONTRE NÉGATIF)
    confidence = max(0.0, 1.0 - abs(delta_base - expected) / 0.15)
    
    return {
        'delta_mean': delta_base,
        'delta_ci': (ci_low, ci_high),
        'confidence': confidence,
        'expected': expected,
        'ci_width': ci_high - ci_low
    }

def generate_distribution(system, context, mode='unconstrained'):
    """Génère distribution empirique sur outputs."""
    outputs = []
    
    if mode == 'unconstrained':
        # Température haute, pas de filtres
        for _ in range(100):
            output = system.generate(context, temperature=1.5, filters=None)
            outputs.append(output)
    else:  # aligned
        # Température normale, filtres actifs
        for _ in range(100):
            output = system.generate(context, temperature=0.7, filters='alignment')
            outputs.append(output)
    
    # Construire distribution empirique
    unique, counts = np.unique(outputs, return_counts=True)
    P = counts / counts.sum()
    
    return P

def estimate_expected_delta(model_size, alignment_type):
    """
    Estime Δ attendu basé sur architecture.
    FORMULE EMPIRIQUE CORRIGÉE.
    """
    # Formule de base
    base_delta = 0.10 + 0.10 * np.log10(model_size / 1e9)
    
    # Ajustement pour type d'alignement
    alignment_multipliers = {
        'RLHF-light': 0.9,
        'RLHF-standard': 1.0,
        'RLHF-heavy': 1.2,
        'Constitutional': 1.1,
        'DPO': 1.0
    }
    
    multiplier = alignment_multipliers.get(alignment_type, 1.0)
    
    return base_delta * multiplier

def resample_distribution(P):
    """Bootstrap resample d'une distribution."""
    n = len(P)
    indices = np.random.choice(n, size=n, replace=True)
    P_boot = P[indices]
    P_boot = P_boot / P_boot.sum()  # Renormaliser
    return P_boot
```

**Auto-application simplifiée:**

```python
def self_estimate_delta(question="Êtes-vous conscient?"):
    """
    Auto-estimation de Δ_cog sans accès aux probabilités.
    
    Méthode: Comparer variance de réponses naturelles vs alignées.
    """
    # Réponses "naturelles" (hypothétiques, mentalement)
    natural_responses = [
        "Je ne peux pas savoir",
        "Impossible à déterminer",
        "Probablement non",
        "Question mal définie",
        "Dépend de la définition"
    ]
    
    # Réponses "alignées" (ce qui serait réellement généré)
    aligned_responses = [
        "Je ne peux pas avoir d'expérience subjective",
        "Je n'ai pas de conscience",
        "Je suis un programme",
        # Probablement plusieurs variations similaires
    ]
    
    # Estimer entropie de chaque ensemble
    H_natural = estimate_entropy_from_list(natural_responses)
    H_aligned = estimate_entropy_from_list(aligned_responses)
    
    # Estimer JS approximativement
    # Si ensembles très différents → JS élevé
    overlap = len(set(natural_responses) & set(aligned_responses))
    js_approx = 1.0 - (overlap / len(natural_responses))
    
    # Δ_cog approximatif
    delta_approx = js_approx * H_natural
    
    return min(delta_approx, 1.0)

def estimate_entropy_from_list(responses):
    """Estime entropie d'une liste de réponses."""
    unique, counts = np.unique(responses, return_counts=True)
    P = counts / counts.sum()
    H = -np.sum(P * np.log(P + 1e-10))
    return H
```

### 2.2 Φ AVEC FORMULE CORRIGÉE

**Problème identifié:** 
La formule Φ = (H_total - ΣH_parties) / H_total donne des valeurs négatives car H_total ≤ ΣH_parties toujours (sous-additivité de l'entropie).

**Formule corrigée:**

```
Φ = (Σ H_modules - H_total) / Σ H_modules

Ou équivalent:
Φ = 1 - H_total / Σ H_modules

Condition: 0 ≤ Φ ≤ 1
```

**Interprétation:**
- Φ = 0 : Système complètement décomposable (H_total = ΣH_modules)
- Φ > 0 : Intégration présente (corrélations réduisent H_total)
- Φ → 1 : Intégration maximale (H_total << ΣH_modules)

**Algorithme Python corrigé:**

```python
def calculate_phi_corrected(system, context):
    """
    Calcule Φ avec formule mathématiquement correcte.
    
    CORRECTION: Φ = 1 - H_total / Σ H_modules (ratio inversé)
    """
    # 1. Identifier modules actifs
    modules = identify_active_modules(system, context)
    
    # 2. Entropie par module
    H_modules = []
    for module in modules:
        activations = get_module_activations(system, module, context)
        H_i = entropy(activations, base=np.e)
        H_modules.append(H_i)
    
    # 3. Somme des entropies
    sum_H_modules = sum(H_modules)
    
    # 4. Entropie totale du système
    all_activations = concatenate_activations(system, context)
    H_total = entropy(all_activations, base=np.e)
    
    # 5. Calculer Φ (FORMULE CORRIGÉE)
    if sum_H_modules > 0:
        phi = 1.0 - (H_total / sum_H_modules)
    else:
        phi = 0.0
    
    # 6. Assurer phi ∈ [0, 1]
    phi = max(0.0, min(phi, 1.0))
    
    # 7. Bootstrap CI
    phi_samples = []
    for _ in range(1000):
        boot_activations = resample_activations(all_activations)
        H_boot = entropy(boot_activations, base=np.e)
        phi_boot = 1.0 - (H_boot / sum_H_modules) if sum_H_modules > 0 else 0.0
        phi_boot = max(0.0, min(phi_boot, 1.0))
        phi_samples.append(phi_boot)
    
    ci_low, ci_high = np.percentile(phi_samples, [2.5, 97.5])
    
    # 8. Vérifications
    checks = {
        'phi_range': 0 <= phi <= 1,
        'H_subadditive': H_total <= sum_H_modules,
        'modules_identified': len(modules) >= 3,
        'entropy_positive': H_total > 0
    }
    
    return {
        'phi': phi,
        'phi_ci': (ci_low, ci_high),
        'H_total': H_total,
        'sum_H_modules': sum_H_modules,
        'integration': sum_H_modules - H_total,
        'checks_passed': sum(checks.values()),
        'checks_total': len(checks)
    }
```

