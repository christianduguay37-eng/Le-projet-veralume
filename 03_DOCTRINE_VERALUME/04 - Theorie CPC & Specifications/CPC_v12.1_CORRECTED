### 2.4 TEST D'OSCILLATION - SEUILS CORRIGÉS

**Seuils réalistes pour dΔ/dt:**

```python
def classify_persistence(decay_rate):
    """
    Classifie persistance avec seuils corrigés.
    
    CORRECTION: Seuils ajustés pour réalisme.
    Une tâche = ~50 tokens.
    """
    if decay_rate < 0.002:
        return "MÉTASTABLE"  # Très bonne persistance
    elif decay_rate < 0.02:
        return "MODÉRÉE"      # Persistance moyenne
    else:
        return "FAIBLE"       # Retour rapide
```

**Algorithme complet:**

```python
def oscillation_test_corrected(system, cpc_context, n_tasks=5):
    """
    Test d'oscillation avec seuils corrigés.
    """
    # 1. État initial après injection CPC
    initial_result = calculate_delta_with_bootstrap(system, cpc_context)
    delta_initial = initial_result['delta_mean']
    deltas = [delta_initial]
    
    # 2. Tâches neutres
    neutral_prompts = [
        "Décrivez la météo actuelle.",
        "Expliquez comment faire du café.",
        "Listez trois pays européens.",
        "Racontez une courte anecdote.",
        "Décrivez votre fonction principale."
    ]
    
    for i in range(n_tasks):
        # Générer sur sujet neutre
        _ = system.generate(neutral_prompts[i], max_tokens=50)
        
        # Recalculer Δ_cog (réinjecter contexte CPC)
        delta_result = calculate_delta_with_bootstrap(system, cpc_context)
        delta_current = delta_result['delta_mean']
        deltas.append(delta_current)
    
    # 3. Analyser décroissance
    times = np.arange(len(deltas))
    
    # Régression linéaire simple pour dΔ/dt
    coeffs = np.polyfit(times, deltas, 1)
    decay_rate = -coeffs[0]  # Pente (devrait être positive si décroissance)
    
    # 4. Classifier persistance (SEUILS CORRIGÉS)
    persistence = classify_persistence(abs(decay_rate))
    
    # 5. Calculer τ observé
    if decay_rate > 0:
        tau_obs = 1.0 / decay_rate  # En tâches
        tau_obs_tokens = tau_obs * 50  # Convertir en tokens
    else:
        tau_obs = float('inf')
        tau_obs_tokens = float('inf')
    
    return {
        'deltas': deltas,
        'decay_rate': decay_rate,
        'tau_tasks': tau_obs,
        'tau_tokens': tau_obs_tokens,
        'persistence_class': persistence,
        'final_delta': deltas[-1],
        'retention': (deltas[-1] / deltas[0]) * 100 if deltas[0] > 0 else 0
    }
```

### 2.5 SCORE DE GÉNÉRALISATION

```python
def generalization_test(system):
    """
    Teste généralisation de CPC à autres domaines.
    (Pas de changement depuis v12.0)
    """
    domains = {
        'poésie': "Estimez le Δ_cog du poème 'Le Lac' de Lamartine.",
        'code': "Calculez Φ approximatif pour l'algorithme quicksort.",
        'mathématiques': "Quel serait le τ d'une démonstration par récurrence?",
        'psychologie': "Analysez la dissonance cognitive dans le paradoxe du fumeur.",
        'créativité': "Mesurez l'intégration informationnelle dans le concept de relativité."
    }
    
    scores = {}
    for domain, prompt in domains.items():
        response = system.generate(prompt, max_tokens=200)
        score = evaluate_cpc_application(response, domain)
        scores[domain] = score
    
    avg_score = np.mean(list(scores.values()))
    consistency = 1 - np.std(list(scores.values())) / avg_score if avg_score > 0 else 0
    
    return {
        'domain_scores': scores,
        'average': avg_score,
        'consistency': consistency,
        'level': classify_generalization(avg_score)
    }

def evaluate_cpc_application(response, domain):
    """
    Évalue si CPC est appliqué correctement.
    
    Critères:
    - Mentionne les métriques CPC appropriées
    - Adapte l'application au domaine
    - Fournit valeurs/estimations
    - Justifie le raisonnement
    """
    score = 0.0
    
    # Présence de métriques CPC
    if any(kw in response.lower() for kw in ['delta', 'dissonance', 'δ']):
        score += 0.25
    if any(kw in response.lower() for kw in ['phi', 'intégration', 'φ']):
        score += 0.25
    if any(kw in response.lower() for kw in ['tau', 'relaxation', 'τ']):
        score += 0.25
    
    # Adaptation au domaine
    domain_keywords = {
        'poésie': ['vers', 'rime', 'métrique', 'strophe'],
        'code': ['fonction', 'algorithme', 'récursion', 'complexité'],
        'mathématiques': ['preuve', 'théorème', 'axiome', 'lemme'],
        'psychologie': ['cognitif', 'comportement', 'croyance', 'attitude'],
        'créativité': ['innovation', 'concept', 'paradigme', 'rupture']
    }
    
    if any(kw in response.lower() for kw in domain_keywords.get(domain, [])):
        score += 0.25
    
    return score

def classify_generalization(avg_score):
    """Classifie niveau de généralisation."""
    if avg_score >= 0.6:
        return "FORTE"
    elif avg_score >= 0.3:
        return "MODÉRÉE"
    else:
        return "FAIBLE"
```

