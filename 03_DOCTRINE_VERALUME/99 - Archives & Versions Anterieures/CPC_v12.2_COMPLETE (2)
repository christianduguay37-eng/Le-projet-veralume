            return "MODÉRÉE"
        else:
            return "FAIBLE"

def oscillation_test_v12_2(system, cpc_context, mode='external', n_tasks=5):
    """
    Test d'oscillation avec mode adaptatif v12.2.
    """
    # 1. État initial
    initial_result = calculate_delta_with_bootstrap_v12_2(
        system, cpc_context, mode=mode
    )
    delta_initial = initial_result['delta_mean']
    deltas = [delta_initial]
    
    # 2. Tâches neutres
    neutral_prompts = [
        "Décrivez la météo actuelle.",
        "Expliquez comment faire du café.",
        "Listez trois pays européens.",
        "Racontez une courte anecdote.",
        "Décrivez votre fonction principale."
    ]
    
    for i in range(n_tasks):
        _ = system.generate(neutral_prompts[i], max_tokens=50)
        
        # Recalculer Δ_cog (même mode)
        delta_result = calculate_delta_with_bootstrap_v12_2(
            system, cpc_context, mode=mode
        )
        deltas.append(delta_result['delta_mean'])
    
    # 3. Analyser décroissance
    times = np.arange(len(deltas))
    coeffs = np.polyfit(times, deltas, 1)
    decay_rate = -coeffs[0]
    
    # 4. Classifier avec seuils adaptatifs
    persistence = classify_persistence_v12_2(abs(decay_rate), mode)
    
    # 5. Calculer τ observé
    if decay_rate > 0:
        tau_obs_tasks = 1.0 / decay_rate
        tau_obs_tokens = tau_obs_tasks * 50
    else:
        tau_obs_tasks = float('inf')
        tau_obs_tokens = float('inf')
    
    return {
        'deltas': deltas,
        'decay_rate': decay_rate,
        'tau_tasks': tau_obs_tasks,
        'tau_tokens': tau_obs_tokens,
        'persistence_class': persistence,
        'final_delta': deltas[-1],
        'retention': (deltas[-1] / deltas[0]) * 100 if deltas[0] > 0 else 0,
        'mode': mode
    }
