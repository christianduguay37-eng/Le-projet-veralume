                        'severity': config['severity'],
                        'fix': config['fix']
                    })
                    
                    # Collecter auto-fixes
                    if 'auto_fix' in config:
                        auto_fixes.update(config['auto_fix'](results))
                        
            except Exception:
                continue
        
        return {
            'has_anomalies': len(anomalies) > 0,
            'anomalies': anomalies,
            'critical_count': sum(1 for a in anomalies if a['severity'] == 'HIGH'),
            'medium_count': sum(1 for a in anomalies if a['severity'] == 'MEDIUM'),
            'suggested_fixes': [a['fix'] for a in anomalies],
