### 3.1 SCORE DE COHÉRENCE MULTIVARIÉE

**Nouveau dans v12.2:** Cohérence mesurée sur 5 dimensions

```python
def coherence_score_v12_2(results):
    """
    Score de cohérence multivariée (0-1).
    
    Vérifie 5 dimensions de cohérence:
    1. Δ vs τ (relation théorique)
    2. Δ vs Φ (corrélation attendue)
    3. Oscillation vs Δ (persistance cohérente)
    4. Confiance vs CI (largeur cohérente)
    5. Généralisation vs Φ (capacité cohérente)
    
    Returns:
        float: Score de cohérence [0, 1]
    """
    checks = []
    
    # 1. COHÉRENCE Δ vs τ
    if 'delta' in results and 'tau_obs' in results:
        tau_pred = tau_continuous_v12_2(results['delta'])
        tau_obs = results['tau_obs']
        
        if tau_obs > 0 and np.isfinite(tau_obs):
            error = abs(tau_pred - tau_obs) / tau_obs
            checks.append(error < 0.5)
    
    # 2. COHÉRENCE Δ vs Φ
    if 'delta' in results and 'phi' in results:
        # Δ élevé → Φ élevé attendu (systèmes intégrés)
        delta = results['delta']
        phi = results['phi']
        
        # Relation attendue: Δ > 0.4 devrait avoir Φ > 0.3
        if delta > 0.4:
            checks.append(phi > 0.3)
        elif delta <= 0.4:
            # Accepter tout Φ pour Δ faible
            checks.append(True)
    
    # 3. COHÉRENCE OSCILLATION vs Δ
    if 'decay_rate' in results and 'delta' in results:
        delta = results['delta']
        decay = results['decay_rate']
        
        # Δ élevé → décroissance lente attendue
        if delta > 0.5:
            checks.append(decay < 0.03)
        else:
            checks.append(True)
    
    # 4. COHÉRENCE CONFIANCE vs CI
    if 'confidence' in results and 'delta_ci_width' in results:
        conf = results['confidence']
        ci_width = results['delta_ci_width']
        
        # Large CI → basse confiance
        # Petite CI → haute confiance
        ci_confidence = (ci_width < 0.2)
        conf_high = (conf > 0.5)
        
        checks.append(ci_confidence == conf_high)
    
    # 5. COHÉRENCE GÉNÉRALISATION vs Φ
    if 'generalization' in results and 'phi' in results:
        phi = results['phi']
        gen_score = results['generalization']
        
        # Φ élevé → bonne généralisation attendue
        if phi > 0.25:
            checks.append(gen_score > 0.4)
        else:
            checks.append(True)
    
    # Score final
    return sum(checks) / len(checks) if checks else 0.0
