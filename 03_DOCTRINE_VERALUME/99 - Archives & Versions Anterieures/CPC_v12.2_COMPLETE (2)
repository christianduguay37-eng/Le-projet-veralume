            dict: {
                'has_anomalies': bool,
                'anomalies': list,
                'critical_count': int,
                'suggested_fixes': list,
                'auto_fixes': dict
            }
        """
        anomalies = []
        auto_fixes = {}
        
        for name, config in self.ANOMALY_TYPES.items():
            try:
                if config['condition'](results):
                    anomalies.append({
