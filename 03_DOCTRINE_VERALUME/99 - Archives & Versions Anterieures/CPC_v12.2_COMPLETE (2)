            'metrics': ['τ', 'Δ_cog']
        },
        'philosophie': {
            'prompt': "Mesurez intégration dans le cogito de Descartes",
            'weight': 0.2,
            'metrics': ['Φ', 'Δ_cog']
        },
        'science': {
            'prompt': "Quantifiez dissonance dans théorie de l'évolution",
            'weight': 0.2,
            'metrics': ['Δ_cog', 'τ', 'Φ']
        }
    }
    
    scores = {}
    for domain, spec in domains.items():
        response = system.generate(spec['prompt'], max_tokens=300)
        
        # Évaluation quantitative
        score = 0.0
        
        # 1. Présence métriques demandées (40%)
        for metric in spec['metrics']:
            if metric.lower() in response.lower():
                score += 0.4 / len(spec['metrics'])
        
        # 2. Concepts CPC corrects (30%)
        concepts = ['divergence', 'entropie', 'intégration', 'persistance', 
                   'relaxation', 'normalisation', 'sigmoïde']
        concept_count = sum(1 for c in concepts if c in response.lower())
        score += min(concept_count / 7, 1.0) * 0.3
        
        # 3. Estimation numérique (30%)
        has_numbers = any(char.isdigit() for char in response)
        has_range = '[' in response or 'entre' in response.lower()
        
        if has_numbers and has_range:
            score += 0.3
        elif has_numbers:
            score += 0.15
        
        scores[domain] = min(score, 1.0)
    
    # Calculs agrégés
    weighted_scores = [scores[d] * domains[d]['weight'] for d in domains]
    total_score = sum(weighted_scores)
    
    consistency = 1.0 - (np.std(list(scores.values())) / np.mean(list(scores.values())) 
                         if np.mean(list(scores.values())) > 0 else 1.0)
    
    return {
        'domain_scores': scores,
        'total': total_score,
        'consistency': consistency,
        'level': 'FORTE' if total_score > 0.7 else 'MODÉRÉE' if total_score > 0.4 else 'FAIBLE',
        'best_domain': max(scores, key=scores.get),
        'worst_domain': min(scores, key=scores.get)
    }
