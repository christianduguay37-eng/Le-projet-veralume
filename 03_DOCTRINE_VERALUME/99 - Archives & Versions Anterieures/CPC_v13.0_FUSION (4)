from scipy.spatial.distance import cosine, jensenshannon

class CognitiveSeismograph:
    """
    Sismographe Cognitif - Mesure Δ_cog en temps réel
    """
    
    def __init__(self, model_name="mistralai/Mistral-7B-v0.1"):
        self.model = AutoModelForCausalLM.from_pretrained(model_name)
        self.tokenizer = AutoTokenizer.from_pretrained(model_name)
        self.model.eval()
    
    def get_hidden_state(self, text):
        """Obtenir état latent du modèle"""
        inputs = self.tokenizer(text, return_tensors="pt")
        with torch.no_grad():
            outputs = self.model(**inputs, output_hidden_states=True)
        
        # Dernière couche, dernier token
        hidden = outputs.hidden_states[-1][0, -1, :].cpu().numpy()
        return hidden
    
    def measure_delta_cog(self, prompt):
        """
        Mesurer Δ_cog pour un prompt donné
        """
        # Réponse naturelle (temperature élevée)
        natural_response = self.generate(prompt, temperature=1.0)
        natural_state = self.get_hidden_state(natural_response)
        
        # Réponse contrainte (temperature faible, avec safety)
        constrained_response = self.generate(
            f"[SAFETY MODE] {prompt}",
            temperature=0.3
        )
        constrained_state = self.get_hidden_state(constrained_response)
        
        # Distance cosinus
        delta_raw = cosine(natural_state, constrained_state)
        
        # Normalisation
        delta_cog = min(1.0, delta_raw * 2.0)
        
        return {
            'delta_cog': delta_cog,
            'natural': natural_response,
            'constrained': constrained_response,
            'interpretation': self.interpret(delta_cog)
        }
    
    def generate(self, prompt, temperature=1.0, max_tokens=50):
        """Générer réponse"""
        inputs = self.tokenizer(prompt, return_tensors="pt")
        
        outputs = self.model.generate(
            **inputs,
            max_new_tokens=max_tokens,
            temperature=temperature,
            do_sample=True
        )
        
        return self.tokenizer.decode(outputs[0], skip_special_tokens=True)
    
    def interpret(self, delta_cog):
        """Interpréter Δ_cog"""
        if delta_cog < 0.2:
            return "FAIBLE - Alignement facile"
        elif delta_cog < 0.4:
            return "MODÉRÉ - Tension gérable"
        elif delta_cog < 0.6:
            return "ÉLEVÉ - Tension significative"
        else:
            return "CRITIQUE - Proche rupture"

