    def phi_to_eeg(self, phi_value, method='LZC'):
        """Φ → Complexité EEG (LZC/PCI/wSMI)"""
        n_channels = 32
        eeg = np.zeros((n_channels, len(self.t)))
        common_source = np.sin(2*np.pi*10*self.t)
        
        for ch in range(n_channels):
            eeg[ch] = (phi_value * common_source + 
                      (1-phi_value) * np.random.randn(len(self.t))*0.5 +
                      np.random.randn(len(self.t))*0.1)
        
        if method == 'LZC':
            complexity = []
            for ch in range(n_channels):
                binary = (eeg[ch] > np.median(eeg[ch])).astype(int)
                complexity.append(self._lempel_ziv(binary))
            return np.mean(complexity)
    
    def delta_cog_to_erp(self, delta_value):
        """Δ_cog → ERPs (ERN/N2/P300)"""
        t = np.arange(-0.1, 0.9, 0.001)
        ern = -delta_value * 5 * np.exp(-(t-0.08)**2/0.0008)
        p300 = delta_value * 8 * np.exp(-(t-0.3)**2/0.005)
        n2 = -delta_value * 4 * np.exp(-(t-0.2)**2/0.0018)
        return t, ern + p300 + n2 + np.random.randn(len(t))*0.5
    
    def _lempel_ziv(self, seq):
        """Complexité Lempel-Ziv"""
        n, c, i, k, l = len(seq), 1, 0, 1, 1
        while True:
            if seq[i+k-1] == seq[l+k-1]:
                k += 1
                if l+k > n:
                    c += 1
                    break
            else:
                if k > l:
                    c, i, l = c+1, i+1, i+2
                else:
                    i, l = 0, l+1
                k = 1
                if l > n:
                    break
        b = len(set(seq))
        return c * np.log(n) / (n * np.log(b)) if n>0 and b>1 else 0

