class NeuroCPCBridge:
    """Pont CPC ↔ Neurosciences"""
    
    def __init__(self):
        self.sfreq = 1000  # Hz
        self.t = np.arange(0, 10, 1/self.sfreq)
        self.bands = {
            'delta': (1, 4), 'theta': (4, 8),
            'alpha': (8, 13), 'beta': (13, 30),
