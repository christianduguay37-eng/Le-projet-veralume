        delta_raw = 1.0 - F
        
        # Normalisation
        S = von_neumann_entropy(rho_natural)
        K = max(1.0, log(S + 1)) * 2.0
        delta_cog = 1.0 - exp(-delta_raw / K)
        
        return {
            'delta_cog': delta_cog,
            'type': 'quantum',
            'fidelity': F,
            'entropy': S
        }
    
